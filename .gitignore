# Dependencies
node_modules/
backend/.venv/
frontend/.venv/
.venv/

# Build output
frontend/dist/
frontend/.vite/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Cached ERDDAP responses, regenerated on demand. Demo fixtures live in data/.
backend/app/cache_store/*
!backend/app/cache_store/.gitignore

# Screenshots and local screenshot scripts
temporary screenshots/
/screenshot.mjs
/shot.mjs
/shot-map.mjs

# Personal notes and drafts (only the README is shared)
/*.md
!/README.md
/docs/
/spacex/

# Full-size INCOIS seal (5.5 MB); the app uses the downscaled copies
brand_assets/incois-logo-original.png

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Credentials - never commit these. .env.example has the variable names only.
.env
*.env
!*.env.example
backend/.env
backend/app/assistant_store/*
!backend/app/assistant_store/.gitignore
