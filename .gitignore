# Dependencies
node_modules/
backend/.venv/
frontend/.venv/
.venv/

# Build output
frontend/dist/
frontend/.vite/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Cached INCOIS ERDDAP responses. These are regenerated on demand and can be
# large; the committed demo fixtures live in data/ instead.
backend/app/cache_store/*
!backend/app/cache_store/.gitignore

# Verification artifacts
temporary screenshots/

# The original 14584x14584 INCOIS seal (5.5 MB). The downscaled 64/128/256 px
# versions used by the app are committed.
brand_assets/incois-logo-original.png

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Credentials. Copernicus Marine requires an account, and its username/password
# are a personal login, not a project secret to share — they must never be
# committed. .env.example carries the variable NAMES only.
.env
*.env
!*.env.example
backend/.env
backend/app/assistant_store/*
!backend/app/assistant_store/.gitignore
