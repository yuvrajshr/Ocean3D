# Copy to backend/.env and fill in your own values. Don't put secrets in this file.

# Copernicus Marine account (free): https://data.marine.copernicus.eu/register
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=

# Gemini API key for the assistant (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google Search grounding: "auto" (default), "on" or "off".
# It isn't included in the free tier, so use "off" on a free key.
GEMINI_SEARCH=auto

# Model, and fallbacks tried in order when rate limited. Defaults:
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
# Thinking level: "minimal" (default), "low", "medium", "high", or empty.
# GEMINI_THINKING=minimal

# Open the Copernicus store at startup so the first point read is faster.
# Set to "off" for tests or offline use.
# OCEANVIZ_WARM=on
