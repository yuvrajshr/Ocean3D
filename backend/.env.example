# Copy this file to `backend/.env` and fill in your own values.
# `.env` is gitignored; this example file is not, and must stay empty of secrets.
#
# Copernicus Marine account — free, register at:
#   https://data.marine.copernicus.eu/register
# Used only by the backend, server-side. The browser never sees these.
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=

# Gemini API key for the ocean assistant - free tier, register at:
#   https://aistudio.google.com/apikey
# Server-side only; the browser never sees it.
GEMINI_API_KEY=

# Google Search grounding for the assistant: "auto" (default), "on", or "off".
# Grounding is billed separately and is NOT in the free tier - on a free key set
# this to "off" to skip the probe. Enable billing to use it.
GEMINI_SEARCH=auto
