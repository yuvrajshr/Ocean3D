# Normalise line endings to LF in the repo so Windows and Mac clones don't
# show every line as changed.
* text=auto

# Binary files - don't try to diff or merge them
*.jpg   binary
*.jpeg  binary
*.png   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.nc    binary

# The MoES SVGs are mostly base64, so diffs are just noise
*.svg   -diff

# Lockfiles are generated. On a conflict, take main's copy and re-run npm install.
package-lock.json          -diff linguist-generated=true
frontend/package-lock.json -diff linguist-generated=true
